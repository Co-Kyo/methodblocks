{
  "name": "methodblocks",
  "version": "0.1.1",
  "description": "把方法论做成积木：面向执行的 markdown 积木化——目标/动作/例三部件，引用名字即引用文字，缺席即红。不做通用 markdown 工具；只认部件与拼装，不认编排。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Co-Kyo/methodblocks.git"
  },
  "bugs": {
    "url": "https://github.com/Co-Kyo/methodblocks/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.5.0"
  }
}
